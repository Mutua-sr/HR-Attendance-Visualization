Options -Indexes
RewriteEngine On

# Route /api/* to api.php with the path as a query parameter
RewriteRule ^api/(.*)$ api.php?path=/$1 [QSA,L]

# Block direct access to sensitive files
<FilesMatch "(config\.php|\.env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block the db/ directory from web access (init.php excluded via direct URL only)
<FilesMatch "\.(sql)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
